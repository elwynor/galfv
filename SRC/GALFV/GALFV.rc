    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Elwynor Technologies"
            VALUE "FileDescription",  "File Viewer - document viewer and library for The Major BBS v10"
            VALUE "FileVersion",      "1.3.4.0"
            VALUE "InternalName",     "GALFV"
            VALUE "LegalCopyright",   "Copyright (c) 2026 Elwynor Technologies. Originally (c) 1995 High Velocity Software, Inc."
            VALUE "OriginalFilename", "GALFV.DLL"
            VALUE "ProductName",      "File Viewer"
            VALUE "ProductVersion",   "1.3.4"
            VALUE "Comments",         "Converted for The Major BBS v10 by Mark Laudenbach - https://github.com/laudenbachm"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
